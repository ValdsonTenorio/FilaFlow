# Ambiente compartilhado pelo Docker Compose. Nunca use credenciais reais neste arquivo.
POSTGRES_DB=filaflow
POSTGRES_USER=filaflow_app
POSTGRES_PASSWORD=troque-esta-senha-local
DATABASE_URL=postgresql://filaflow_app:troque-esta-senha-local@postgres:5432/filaflow?schema=public
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
